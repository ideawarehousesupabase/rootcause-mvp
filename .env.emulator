# Local testing against the Firebase emulators (npm run emulators, then npm run dev:emulator).
# "demo-" project IDs never touch a real Firebase project. Overrides the values in .env.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-rootcause.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-rootcause
VITE_FIREBASE_STORAGE_BUCKET=demo-rootcause.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_MEASUREMENT_ID=
VITE_USE_EMULATORS=true
VITE_FIRESTORE_EMULATOR_PORT=8181
VITE_FUNCTIONS_EMULATOR_PORT=5401
